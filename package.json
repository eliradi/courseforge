{
  "name": "aceversity",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "create-admin": "tsx --env-file=.env.local scripts/create-admin.ts",
    "db:push": "for f in supabase/migrations/*.sql; do psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f \"$f\"; done",
    "db:seed": "psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f supabase/seed.sql",
    "db:types": "supabase gen types typescript --db-url \"$SUPABASE_DB_URL\" --schema public > lib/supabase/database.types.ts",
    "dev": "next dev",
    "embed-courses": "tsx --conditions=react-server --env-file=.env.local scripts/embed-courses.ts",
    "generate-probe": "tsx --conditions=react-server --env-file=.env.local scripts/generate-probe.ts",
    "lint": "eslint",
    "probe": "tsx --conditions=react-server --env-file=.env.local scripts/scrape-probe.ts",
    "repair-titles": "tsx --conditions=react-server --env-file=.env.local scripts/repair-course-titles.ts",
    "start": "next start",
    "sweep": "tsx --conditions=react-server --env-file=.env.local scripts/discovery-sweep.ts",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^1.0.41",
    "@base-ui/react": "^1.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "ai": "^5.0.258",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.46.0",
    "next": "15.5.25",
    "next-themes": "^0.4.6",
    "p-queue": "^9.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "resend": "^6.28.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "simple-icons": "^16.31.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "packageManager": "pnpm@9.15.0"
}
