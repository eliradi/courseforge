# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection (used by `pnpm db:push` / `pnpm db:seed` only)
SUPABASE_DB_URL=

# ---- AI (Vercel AI Gateway) ----
AI_GATEWAY_API_KEY=

# ---- Scraper service ----
SCRAPER_SERVICE_URL=           # e.g. https://aceversity-scraper.fly.dev
SCRAPER_SERVICE_SECRET=        # shared secret; sent as x-scraper-secret header

# ---- Optional ----
BRAVE_SEARCH_API_KEY=          # web-search assist when URL heuristics fail
RESEND_API_KEY=                # emailed test exports
NEXT_PUBLIC_SITE_URL=http://localhost:3000
