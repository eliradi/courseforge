{
  "name": "aceversity-scraper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted Playwright scraping service for Aceversity.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "cheerio": "^1.0.0",
    "hono": "^4.6.14",
    "playwright": "1.49.1",
    "turndown": "^7.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/turndown": "^5.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
